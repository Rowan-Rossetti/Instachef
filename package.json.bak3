{
  "name": "instachef",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:ssr": "ng build && ng run instachef:server",
    "serve:ssr": "node dist/instachef/server/main.js",
    "dev:ssr": "ng run instachef:serve-ssr",
    "test": "ng test",
    "deploy": "ng build --configuration production --base-href /Instachef/ && gh-pages -d dist/instachef/browser -b gh-pages",
    "deploy:gh": "ng build --configuration production --base-href /Instachef/ && gh-pages -d dist/instachef/browser -b gh-pages",
    "check": "ng build --configuration development && ng lint"
  },
  "private": true,
  "devDependencies": {
    "@angular-eslint/builder": "^22.5.0",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/template-parser": "^22.5.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@types/angular": "^1.8.9",
    "@types/express": "^5.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.15.17",
    "gh-pages": "^6.3.0",
    "istanbul-lib-instrument": "^6.0.3",
    "sass": "^1.89.2",
    "typescript": "^6.0.3",
    "vite": "^6.3.6"
  },
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/localize": "^22.2.2",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-browser-dynamic": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/ssr": "^22.2.2",
    "domutils": "^3.2.2",
    "express": "^4.18.2",
    "html2pdf.js": "^0.14.0",
    "is-number": "^7.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  }
}
