{
  "name": "instachef",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test --watch=false",
    "deploy": "ng build --configuration production --base-href /Instachef/ && echo \"Build termine. Le deploiement est gere par GitHub Actions apres un git push.\"",
    "deploy:gh": "ng build --configuration production --base-href /Instachef/ && echo \"Build termine. Le deploiement est gere par GitHub Actions apres un git push.\"",
    "check": "npm run build && npm run lint && npm test",
    "lint": "ng lint"
  },
  "private": true,
  "devDependencies": {
    "@angular-eslint/builder": "^22.5.0",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/template-parser": "^22.5.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.17",
    "angular-eslint": "^22.5.0",
    "jsdom": "^30.1.2",
    "sass": "^1.89.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
